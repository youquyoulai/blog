{
  "name": "blog",
  "version": "1.0.0",
  "description": "由 Hugo + weisaygrace 主题生成的静态博客，部署在 Cloudflare Pages。",
  "scripts": {
    "build": "hugo --minify --cleanDestinationDir",
    "dev": "hugo server -D --disableFastRender",
    "preview": "hugo server --disableFastRender",
    "new": "hugo new",
    "new:note": "hugo new notes/$(date +%Y-%m-%d)-note.md",
    "optimize:images": "echo 'Use sharp scripts in _scripts/ to optimize images'",
    "favicon": "png-to-ico static/logo.png > static/favicon.ico"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youquyoulai/blog.git"
  },
  "keywords": ["hugo", "blog", "weisaygrace"],
  "author": "平哥",
  "license": "ISC",
  "devDependencies": {
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  }
}
