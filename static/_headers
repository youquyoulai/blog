# 安全响应头（所有页面）
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://img.pgoj.top https://waline.pgoj.top https://cdn.jsdelivr.net data:; font-src 'self'; connect-src 'self' https://waline.pgoj.top; frame-ancestors 'self'

# Admin 后台需要连接 API（api.pgoj.top）和 R2 图库
/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://img.pgoj.top data:; font-src 'self'; connect-src 'self' https://api.pgoj.top; frame-ancestors 'self'

# CSS 带 hash 指纹，可长期缓存
/css/*.css
  Cache-Control: public, max-age=31536000, immutable

# JS 带 hash 指纹，可长期缓存
/js/*.js
  Cache-Control: public, max-age=31536000, immutable

# Waline JS/CSS 缓存 1 天（文件名无 hash）
/js/waline/*
  Cache-Control: public, max-age=86400

# 图片缓存 30 天
/*.webp
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.jpeg
  Cache-Control: public, max-age=2592000

# HTML 文件不缓存（保证内容更新即时生效）
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# RSS/JSON 不缓存（内容更新需同步）
/feed.xml
  Cache-Control: public, max-age=0, must-revalidate
/searchindex.json
  Cache-Control: public, max-age=0, must-revalidate
