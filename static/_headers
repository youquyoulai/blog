# 安全响应头（所有页面）
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # S01: 收紧 CSP —— 仅保留聚合站实际所需来源（已移除旧博客残留的 waline/cravatar/weavatar/myqcloud/weread/jsdelivr/img.pgoj.top 等域名）
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.pgoj.top; frame-ancestors 'self'

# 图片缓存 30 天
/*.webp
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.jpeg
  Cache-Control: public, max-age=2592000

# HTML 文件不缓存（保证内容更新即时生效）
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# RSS/JSON 不缓存（内容更新需同步）
/feed.xml
  Cache-Control: public, max-age=0, must-revalidate
